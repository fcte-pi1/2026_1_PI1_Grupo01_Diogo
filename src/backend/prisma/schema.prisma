generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Histórico das Corridas
model Run {
  id          String      @id @default(uuid())
  status      String      @default("EM_ANDAMENTO")
  startedAt   DateTime    @default(now())
  endedAt     DateTime?

  // Métricas agregadas da corrida, calculadas na finalização (auto ou manual).
  tempoConclusaoMs   Int?     @map("tempo_conclusao_ms")
  velocidadeMedia    Float?   @map("velocidade_media")
  consumoBateriaPct  Int?     @map("consumo_bateria_pct")
  desafioCumprido    Boolean? @map("desafio_cumprido")
  trajetoCoordenadas String?  @map("trajeto_coordenadas")

  // Dimensão do labirinto (N x N) informada pelo firmware na telemetria.
  tamanhoLabirinto   Int?     @map("tamanho_labirinto")

  telemetries Telemetry[]

  @@map("runs")
}

// Dados da Telemetria (Totalmente aderente ao contrato)
model Telemetry {
  id              String   @id @default(uuid())
  runId           String   @map("run_id")
  
  tempoCorridaMs  Int      @map("tempo_corrida_ms")
  posicaoX        Int      @map("posicao_x")
  posicaoY        Int      @map("posicao_y")
  direcaoAtual    String   @map("direcao_atual")
  estadoRobo      String   @map("estado_robo")
  bateriaPct      Int      @map("bateria_pct")
  
  // Leitura de Sensores
  distFrenteCm    Float    @map("dist_frente_cm")
  distEsquerdaCm  Float    @map("dist_esquerda_cm")
  distDireitaCm   Float    @map("dist_direita_cm")
  
  timestamp       DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("telemetries")
}